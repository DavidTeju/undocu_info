# Supabase Self-Hosted Configuration
# Copy this file and fill in your values
# On VPS: /root/supabase-docker/.env

############
# Secrets - Generate unique values for each environment
############
POSTGRES_PASSWORD=your-super-secret-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
ANON_KEY=generate-with-supabase-cli-or-jwt-generator
SERVICE_ROLE_KEY=generate-with-supabase-cli-or-jwt-generator
DASHBOARD_PASSWORD=your-dashboard-password
SECRET_KEY_BASE=your-secret-key-base-for-studio

############
# URLs - Update for your domain
############
SITE_URL=https://undocustudent.org
API_EXTERNAL_URL=https://files.undocustudent.org
SUPABASE_PUBLIC_URL=https://files.undocustudent.org

############
# SMTP Configuration (Resend)
############
SMTP_ADMIN_EMAIL=admin@yourdomain.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_SENDER_NAME=UndocuStudent

############
# Email Templates (hosted via nginx at /var/www/email-templates/)
############
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=https://undocustudent.org/email-templates/magiclink.html
GOTRUE_MAILER_TEMPLATES_RECOVERY=https://undocustudent.org/email-templates/magiclink.html
GOTRUE_MAILER_TEMPLATES_INVITE=https://undocustudent.org/email-templates/magiclink.html
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=https://undocustudent.org/email-templates/magiclink.html

############
# Email Subjects
############
GOTRUE_MAILER_SUBJECTS_MAGIC_LINK=Your Verification Code
GOTRUE_MAILER_SUBJECTS_RECOVERY=Reset Your Password
GOTRUE_MAILER_SUBJECTS_INVITE=You have been invited
GOTRUE_MAILER_SUBJECTS_CONFIRMATION=Confirm Your Email

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Umami Analytics
############
UMAMI_APP_SECRET=generate-with-openssl-rand-hex-32

############
# Other
############
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model colleges {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @unique
  domain                     String                       @unique
  city                       String?
  state                      String?
  hidden                     Boolean?                     @default(false)
  Suggestions                Suggestions[]
  email_outreach_sends       email_outreach_sends[]
  email_outreach_suppression email_outreach_suppression[]
  emailaddresses             emailaddresses[]
  responses                  responses[]
}

model emailaddresses {
  emailaddress        String    @id(map: "email_addresses_pkey")
  collegeid           Int
  verification_status String?
  verification_score  Int?
  verified_at         DateTime? @db.Timestamptz(6)
  colleges            colleges  @relation(fields: [collegeid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([verification_status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id        Int         @id @default(autoincrement())
  question  String      @unique
  category  String
  responses responses[]
}

model responses {
  id         Int       @id(map: "questionresponses_pkey") @default(autoincrement())
  collegeid  Int
  response   String
  questionid Int
  colleges   colleges  @relation(fields: [collegeid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "questionresponses_collegeid_fkey")
  questions  questions @relation(fields: [questionid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([collegeid, questionid])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Suggestions {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  content         Json      @db.Json
  college_domain  String
  reviewed_at     DateTime? @db.Timestamptz(6)
  status          String    @default("pending")
  submitter_email String?
  remarks         String?
  colleges        colleges  @relation(fields: [college_domain], references: [domain], onDelete: Cascade, onUpdate: NoAction)
}

/// Audit log of every outreach email attempt. One row per send, written at send time.
/// Status reflects the outcome: sent, failed, bounced, suppressed, complained.
model email_outreach_sends {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  college_id      Int
  email_address   String
  email_type      String
  status          String
  sent_at         DateTime? @db.Timestamptz(6)
  resend_email_id String?   @unique
  error_message   String?
  colleges        colleges  @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@index([college_id])
  @@index([college_id, email_address])
  @@index([status])
  @@index([sent_at])
}

/// Durable suppression state populated only from Resend webhook events.
model email_outreach_suppression {
  id                BigInt   @id @default(autoincrement())
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)
  college_id        Int
  email_address     String
  reason            String
  source_event_type String
  resend_email_id   String?
  details           Json?    @db.Json
  colleges          colleges @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@unique([college_id, email_address])
  @@index([email_address])
  @@index([resend_email_id])
}

/// Log of all email outreach runs for auditing and viewing results
model email_outreach_log {
  id               BigInt    @id @default(autoincrement())
  run_started_at   DateTime  @default(now()) @db.Timestamptz(6)
  run_completed_at DateTime? @db.Timestamptz(6)
  total_queued     Int       @default(0)
  total_sent       Int       @default(0)
  total_failed     Int       @default(0)
  total_bounced    Int       @default(0)
  details          Json?     @db.Json
  status           String    @default("running")
}

enum question_category {
  admission
  financial
  life
  other
}

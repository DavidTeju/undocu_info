generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model colleges {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  domain         String           @unique
  city           String?
  state          String?
  hidden         Boolean?         @default(false)
  Suggestions    Suggestions[]
  emailaddresses emailaddresses[]
  responses      responses[]
}

model emailaddresses {
  emailaddress String   @id(map: "email_addresses_pkey")
  collegeid    Int
  colleges     colleges @relation(fields: [collegeid], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id        Int         @id @default(autoincrement())
  question  String      @unique
  category  String
  responses responses[]
}

model responses {
  id         Int       @id(map: "questionresponses_pkey") @default(autoincrement())
  collegeid  Int
  response   String
  questionid Int
  colleges   colleges  @relation(fields: [collegeid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "questionresponses_collegeid_fkey")
  questions  questions @relation(fields: [questionid], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Suggestions {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  content         Json      @db.Json
  college_domain  String
  status          String    @default("pending") // pending, approved, rejected
  reviewed_at     DateTime? @db.Timestamptz(6)
  submitter_email String?
  remarks         String?   // Additional comments from the submitter
  colleges        colleges  @relation(fields: [college_domain], references: [domain], onDelete: Cascade, onUpdate: NoAction)
}

enum question_category {
  admission
  financial
  life
  other
}

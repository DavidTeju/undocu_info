{
	"name": "svelte-app",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "cd .. && git config core.hooksPath .husky",
		"email:queue": "tsx scripts/email-outreach.ts queue",
		"email:send": "tsx scripts/email-outreach.ts send",
		"email:status": "tsx scripts/email-outreach.ts status",
		"email:logs": "tsx scripts/email-outreach.ts logs"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md,html}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/eslint": "^9.6.0",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/lodash-es": "^4.17.12",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"globals": "^15.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"playwright": "^1.57.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"prisma": "^6.3.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.4.4",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"dependencies": {
		"@prisma/client": "^6.3.1",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.47.10",
		"@sveltejs/adapter-node": "^5.2.12",
		"@tailwindcss/vite": "^4.0.0",
		"anchorme": "^3.0.8",
		"dotenv": "^16.4.7",
		"lodash-es": "^4.17.21",
		"normalize.css": "^8.0.1",
		"resend": "^6.8.0",
		"sass": "^1.83.4",
		"tailwindcss": "^4.0.0"
	}
}
